    {
      "parameters": {
        "jsCode": "const airtableRecord = $('Search records').first().json;\n\n// Airtable Search Records returns the actual fields\n// inside the \"fields\" object.\nconst record = airtableRecord.fields ?? airtableRecord;\n\nconst patientName = record['Patient Name'] ?? null;\nconst phone = record['Phone'] ?? null;\nconst date = record['Date'] ?? null;\nconst service = record['Service'] ?? null;\nconst dentist = record['Dentist'] ?? null;\nconst status = record['Status'] ?? null;\n\nreturn {\n  json: {\n    patient_found: true,\n    patient_name: patientName,\n    phone: phone,\n    last_appointment_date: date,\n    last_appointment_service: service,\n    dentist: dentist,\n    status: status,\n    message: patientName\n      ? `Welcome back, ${patientName}. I can see your last visit was for ${service || 'your previous appointment'} with ${dentist || 'our dental team'}.`\n      : `Welcome back. I found your patient record, but some information is missing.`\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        -192
      ],
