      "name": "IF: Valid Phone?"
    },
    {
      "parameters": {
        "jsCode": "const errorType = $json.phone_error || 'INVALID_PHONE';\n\nif (errorType === 'PHONE_REQUIRED') {\n  return {\n    json: {\n      patient_found: false,\n      phone_valid: false,\n      error: 'PHONE_REQUIRED',\n      message: 'I need your phone number to look up your patient record. Please provide your 10-digit phone number, including the area code.',\n      retry_required: true\n    }\n  };\n}\n\nreturn {\n  json: {\n    patient_found: false,\n    phone_valid: false,\n    error: 'INVALID_PHONE',\n    message: 'I’m sorry, but I couldn’t understand that phone number. Please provide your 10-digit phone number, including the area code.',\n    retry_required: true\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        144
      ],
      "id": "d1cd5e2b-7af4-476c-9b9a-d8e988ee392a",
      "name": "Format Invalid Phone"
    },
    {
      "parameters": {
        "jsCode": "const raw = String($json.phone ?? '').trim();\n\nif (!raw) {\n  return {\n    json: {\n      ...$json,\n      phone: '',\n      phone_valid: false,\n      phone_error: 'PHONE_REQUIRED',\n    }\n  };\n}\n\n// Remove common formatting characters.\nconst digits = raw.replace(/\\D/g, '');\n\n// Accept:\n// 10 digits -> US local number\n// 11 digits beginning with 1 -> US number with country code\nlet normalizedDigits = digits;\n\nif (digits.length === 11 && digits.startsWith('1')) {\n  normalizedDigits = digits.slice(1);\n}\n\nif (normalizedDigits.length !== 10) {\n  return {\n    json: {\n      ...$json,\n      phone: '',\n      phone_valid: false,\n      phone_error: 'INVALID_PHONE',\n    }\n  };\n}\n\nconst normalizedPhone =\n  `${normalizedDigits.slice(0, 3)}-${normalizedDigits.slice(3, 6)}-${normalizedDigits.slice(6)}`;\n\nreturn {\n  json: {\n    ...$json,\n    phone: normalizedPhone,\n    phone_valid: true,\n    phone_error: null,\n  }\n};"
      },
