    {
      "parameters": {
        "jsCode": "const body = $('Resolve Duration').item.json.body;\nconst dateObj = new Date(body.date);\nconst readableDate = dateObj.toLocaleDateString('en-US', { \n  month: 'long', \n  day: 'numeric' \n});\n\nconst [hour, minute] = body.time.split(':');\nconst hourNum = parseInt(hour);\nconst period = hourNum >= 12 ? 'PM' : 'AM';\nconst hour12 = hourNum % 12 === 0 ? 12 : hourNum % 12;\nconst readableTime = `${hour12}:${minute} ${period}`;\n\nreturn {\n  json: {\n    success: true,\n    message: `Your appointment for ${body.appointment_type} with ${body.dentist} is confirmed for ${readableDate} at ${readableTime}.`,\n    appointment_details: {\n      patient_name: body.patient_name,\n      date: body.date,\n      time: body.time,\n      duration_minutes: body.duration_minutes,\n      dentist: body.dentist,\n      appointment_type: body.appointment_type\n    }\n  }\n};"
      },
