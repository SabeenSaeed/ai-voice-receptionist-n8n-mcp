    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const input = $input.item.json;\nconst body = input.body || {};\n\nconst requiredFields = [\n  \"date\",\n  \"time\",\n  \"patient_name\",\n  \"phone\",\n  \"dentist\",\n  \"appointment_type\"\n];\n\nconst missingFields = requiredFields.filter(field => {\n  const value = body[field];\n  return value === undefined ||\n         value === null ||\n         String(value).trim() === \"\";\n});\n\n// Allowed dentists\nconst allowedDentists = [\n  \"Dr. Reyes\",\n  \"Dr. Malik\",\n  \"Dr. Nathan\"\n];\n\nconst errors = [];\n\n// Check required fields\nif (missingFields.length > 0) {\n  errors.push(\n    `Missing required field(s): ${missingFields.join(\", \")}`\n  );\n}\n\n// Check dentist\nif (\n  body.dentist &&\n  !allowedDentists.includes(body.dentist)\n) {\n  errors.push(\n    `Invalid dentist. Allowed dentists: ${allowedDentists.join(\", \")}`\n  );\n}\n\n// Check date format\nif (\n  body.date &&\n  !/^\\d{4}-\\d{2}-\\d{2}$/.test(body.date)\n) {\n  errors.push(\n    \"Invalid date format. Use YYYY-MM-DD.\"\n  );\n}\n\n// Check time format\nif (\n  body.time &&\n  !/^\\d{2}:\\d{2}$/.test(body.time)\n) {\n  errors.push(\n    \"Invalid time format. Use HH:MM.\"\n  );\n}\n\n\n// ==========================================\n// VALIDATION RESULT\n// ==========================================\n\nif (errors.length > 0) {\n\n  return {\n    json: {\n      valid: false,\n      error_message: errors.join(\" \"),\n      error_code: \"VALIDATION_ERROR\",\n      body: null\n    }\n  };\n\n}\n\n\n// ==========================================\n// VALID REQUEST\n// ==========================================\n\nreturn {\n  json: {\n    valid: true,\n    error_message: null,\n    error_code: null,\n\n    body: {\n      date: body.date,\n      time: body.time,\n      patient_name: body.patient_name,\n      phone: body.phone,\n      dentist: body.dentist,\n      appointment_type: body.appointment_type\n    }\n  }\n};"
      },
