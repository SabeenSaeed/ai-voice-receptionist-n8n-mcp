    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// ============================================================\n// RESOLVE APPOINTMENT DURATION\n// Safely handles missing/malformed input\n// ============================================================\n\nconst item = $input.item.json;\n\n// The validated workflow normally stores the request in `body`.\n// We intentionally do NOT silently accept arbitrary malformed data.\nconst body = item?.body;\n\nif (!body || typeof body !== 'object') {\n  return {\n    json: {\n      valid: false,\n      error_message: 'Appointment data is missing or has an invalid structure.',\n      error_code: 'MISSING_APPOINTMENT_BODY'\n    }\n  };\n}\n\n// Required field check.\n// Validate Input should normally catch these first,\n// but this is a final safety net.\nconst requiredFields = [\n  'date',\n  'time',\n  'patient_name',\n  'phone',\n  'dentist',\n  'appointment_type'\n];\n\nconst missingFields = requiredFields.filter(\n  field =>\n    body[field] === undefined ||\n    body[field] === null ||\n    String(body[field]).trim() === ''\n);\n\nif (missingFields.length > 0) {\n  return {\n    json: {\n      valid: false,\n      error_message: `Missing required field(s): ${missingFields.join(', ')}`,\n      error_code: 'MISSING_REQUIRED_FIELDS',\n      missing_fields: missingFields\n    }\n  };\n}\n\n\n// ============================================================\n// DURATION MAP\n// ============================================================\n\nconst durationMap = {\n  \"routine check-up & cleaning\": 45,\n  \"check-up\": 45,\n  \"checkup\": 45,\n  \"cleaning\": 45,\n\n  \"dental x-ray\": 15,\n  \"x-ray\": 15,\n\n  \"tooth filling\": 40,\n  \"filling\": 40,\n\n  \"root canal treatment\": 75,\n  \"root canal\": 75,\n\n  \"dental crown\": 60,\n  \"crown\": 60,\n\n  \"tooth extraction\": 30,\n  \"extraction\": 30,\n\n  \"teeth whitening\": 60,\n  \"whitening\": 60,\n\n  \"orthodontic consultation\": 30,\n  \"braces\": 30,\n  \"invisalign\": 30,\n\n  \"pediatric check-up & cleaning\": 30,\n\n  \"emergency visit\": 30,\n  \"emergency\": 30,\n\n  \"tooth pain\": 30\n};\n\n\n// ============================================================\n// FIND DURATION\n// ============================================================\n\nconst appointmentType = String(body.appointment_type)\n  .toLowerCase()\n  .trim();\n\nlet duration = durationMap[appointmentType];\nlet matched = duration !== undefined;\n\n// Substring matching\nif (!matched) {\n  const matchedKey = Object.keys(durationMap)\n    .sort((a, b) => b.length - a.length)\n    .find(key => appointmentType.includes(key));\n\n  if (matchedKey) {\n    duration = durationMap[matchedKey];\n    matched = true;\n  }\n}\n\n// Safe fallback\nif (!matched) {\n  duration = 30;\n}\n\n\n// ============================================================\n// RETURN ORIGINAL DATA + RESOLVED DURATION\n// ============================================================\n\nreturn {\n  json: {\n    ...item,\n    valid: true,\n    body: {\n      ...body,\n      duration_minutes: duration,\n      duration_matched: matched\n    }\n  }\n};"
      },
